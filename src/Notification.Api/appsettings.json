{
  "ConnectionStrings": {
    "Notifications": "Host=localhost;Port=5432;Database=notifications;Username=postgres;Password=postgres"
  },
  "Outbox": {
    "BatchSize": 100,
    "PollingIntervalSeconds": 5,
    "MaxRetryCount": 5,
    "LockDurationSeconds": 30,
    "WorkerCount": 1
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "notifications",
    "Queue": "notification.processing",
    "RoutingKey": "notification.created",
    "DeadLetterExchange": "notifications.dlx",
    "DeadLetterQueue": "notification.dlq",
    "DeadLetterRoutingKey": "notification.failed",
    "RetryExchange": "notifications.retry",
    "PrefetchCount": 20,
    "ConsumerCount": 1,
    "MaxPriority": 9
  },
  "Resend": {
    "ApiKey": "",
    "From": "Notification Manager <beth.t@example.com>",
    "BaseUrl": "https://api.resend.com",
    "TimeoutSeconds": 30,
    "ReplyTo": ""
  },
  "NotificationRetry": {
    "MaxAttempts": 5,
    "InitialDelaySeconds": 5,
    "MaxDelaySeconds": 600,
    "DelaySeconds": [ 5, 30, 120, 600 ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
